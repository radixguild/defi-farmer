# === Network ===
RADIX_NETWORK_ID=1                    # 1 = mainnet, 2 = stokenet
GATEWAY_URL=https://mainnet.radixdlt.com

# === Non-custodial (2026-07-18) ===
# The agent is an ADVISOR: it scans/scores pools and surfaces proposals, but
# NEVER signs or submits. Money moves only when the USER signs a manifest in
# their own wallet. There is no signing key, vault, or admin badge — the old
# BOT_PRIVATE_KEY / BOT_ACCOUNT / VAULT_COMPONENT / ADMIN_BADGE / AUTO_HARVEST /
# AUTO_REBALANCE / signer-service vars are gone.

# === Agent Settings ===
SCAN_INTERVAL_MS=60000               # Pool scan interval (ms)
# How often scan results are WRITTEN to pool_snapshots/pool_scores. Scanning and
# scoring still run every SCAN_INTERVAL_MS — only the writes are throttled.
# Every reader works in hours (the 7d MA, the 7d/30d charts), so persisting per
# scan wrote ~60x more rows than anything read.
SNAPSHOT_INTERVAL_MS=3600000         # 1h
# Retention sweep. Must be in [30, 3650] — the server refuses to start outside
# that. The floor is the dashboard's 30d chart (720 hourly rows); the ceiling
# stops SQLite's date maths overflowing, which would make prune a silent no-op.
SNAPSHOT_RETENTION_DAYS=30
MIN_REBALANCE_DIFF_BPS=200           # Min APY diff to flag a rebalance opportunity (basis points)
MAX_SLIPPAGE_BPS=50                  # Slippage tolerance shown to the user (basis points)
MAX_GAS_XRD=10                       # Gas shown to the user + used by the rebalance net-benefit gate (XRD)

# === Safety ===
MIN_TVL_THRESHOLD=1000000            # Min TVL for pool to be considered ($) — legacy rebalance-check gate (agent/loop.ts); distinct from MIN_POOL_TVL_USD below
# Dust floor for the ranked opportunity index ($) — the live knob scorer.ts
# actually enforces. Applied only when a pool's TVL is known and positive; a
# $0 reading (e.g. DefiPlaza's child-pool reserves) is unreadable, not dust.
MIN_POOL_TVL_USD=1000

# === Platform fee (monetization Stream C) — docs/MONETIZATION.md ===
# OFF by default: both empty. Fails safe — any invalid or partial config
# disables the fee rather than blocking deposits. When both are set, the fee
# is spliced into the user-signed deposit manifest and shown in the preview
# before the wallet ever sees it.
PLATFORM_FEE_RATE=                   # decimal fraction, e.g. 0.0015 = 0.15%
PLATFORM_FEE_COMPONENT=              # treasury component_ address (try_deposit_or_abort) — an account_ address is rejected

# === Rotation (proposals only — never auto-executed) ===
ROTATION_REVIEW_INTERVAL_MS=604800000  # Weekly rotation review interval (ms, default 7 days)
ROTATION_COOLDOWN_MS=259200000         # Cooldown after rotation before next review (ms, default 3 days)
AUTO_EXECUTE_THRESHOLD_XRD=5000        # Proposals >= this XRD amount are flagged as needing approval in the UI

# === Exit Guards ===
APY_DROP_EXIT_PCT=30                   # Exit when APY drops more than this % from entry
TVL_DROP_EXIT_PCT=40                   # Exit when TVL drops more than this % in 24h

# === API ===
API_PORT=3001                          # HTTP API port for dashboard
API_HOST=127.0.0.1                     # Bind address. Loopback default — set 0.0.0.0 ONLY behind a firewall/proxy
API_AUTH_TOKEN=your_secret_token_here  # Bearer token for API auth (REQUIRED)
# Accounts whose ROLA session counts as operator, comma-separated. The Next
# proxy never forwards the Bearer, so leaving this empty means NO browser
# session is ever an operator and the dashboard's operator panels 401 — that
# is the fail-closed default, not a bug. The Bearer still works for machines.
OPERATOR_ADDRESSES=
# Comma-separated accounts for the operator's read-only watch list
# (GET /api/holdings/watched). For accounts that never ROLA-sign in from a
# browser, e.g. one whose key lives on a server. Grants visibility only:
# holdings are a public-ledger read, no key or custody involved.
WATCH_ADDRESSES=
CORS_ORIGIN=http://localhost:5173      # Allowed CORS origin
TRUST_PROXY=false                      # true ONLY behind Caddy/nginx: rate-limit key uses X-Forwarded-For first hop

# === ROLA auth (Phase 3.1) — must match the frontend's dApp definition + origin ===
DAPP_DEFINITION_ADDRESS=account_rdx1... # on-chain dApp definition account (same as NEXT_PUBLIC_DAPP_DEFINITION_ADDRESS)
ROLA_EXPECTED_ORIGIN=http://localhost:3000  # origin the wallet proof binds to (prod: https://your-domain)
SESSION_COOKIE_SECURE=false             # true behind HTTPS — marks farmer_session cookie Secure

# === Rate Limiting ===
RATE_LIMIT_POST_PER_MIN=10             # Max POST requests per minute per IP
RATE_LIMIT_GET_PER_MIN=60              # Max GET requests per minute per IP

# === Circuit Breaker ===
CIRCUIT_BREAKER_THRESHOLD=5            # Consecutive failures before auto-halt
CIRCUIT_BREAKER_WINDOW_MS=600000       # Time window for circuit breaker (ms, 10 min)

# === Database ===
DB_PATH=./data/defi-farmer.db
