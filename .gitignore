dist/
# bun.lock is committed at the root, frontend/ and server/ (S12, 2026-09-17
# security review): each is a real dependency tree with its own package.json,
# and CI's `--frozen-lockfile` install is a no-op without a lockfile to pin
# against. bun.lockb (the older binary format) is still ignored — this repo
# only ever produces the text `bun.lock`.
bun.lockb
.env
data/
target/
.aider*

