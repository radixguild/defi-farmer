.claude/worktrees/

# Claude skills (local tooling, not part of the shipped app)
.claude/skills/

# Retired docs kept on this machine only
.local-archive/

# Filled-in manifests from scripts/rotate-dapp-def.mjs --manifest. They name an
# account that is not yet the live dApp definition; the template is the artifact
# worth versioning, not a one-off substitution of it.
scripts/manifests/*.generated.txt

