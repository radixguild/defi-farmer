# defi-farmer frontend (Next.js) — server-side env

# URL the Next.js server will hit for the dapp backend. NOT exposed to the browser.
BACKEND_API_URL=http://localhost:3001

# There is deliberately NO API_AUTH_TOKEN here. The proxy stopped attaching the
# operator Bearer (F10/F14/F17) and no frontend source reads it — a copy in
# .env.local is a dead secret. Its one home is the backend's <deploy-root>/.env
# (rotate with scripts/rotate-api-auth-token.sh, which also removes a stray copy).

# Public env vars (browser-visible). Safe to expose.
NEXT_PUBLIC_RADIX_NETWORK_ID=1
NEXT_PUBLIC_DAPP_DEFINITION_ADDRESS=

# Force the UI to render local sample data instead of hitting the API. Dev /
# storybook only — sign actions are disabled while this is on. Leave empty
# in production.
NEXT_PUBLIC_USE_MOCKS=

# ── Gift rails (the tip jar) ────────────────────────────────────────────────
# Both are OPTIONAL and both are OFF until set. /gift 404s and its nav link is
# not rendered while every rail below is empty — there is no separate feature
# flag, because "an address is configured" IS the condition the page depends on.
#
# INVALID IS TREATED AS UNSET. Each value is checksum-validated at module load
# (bech32m for Radix, bech32/bech32m for bc1…), and a rejected value logs a
# [gift] warning during `next build` and leaves that rail dark rather than
# rendering something sendable. Read the build output after changing these.
#
# ⚠ NEXT_PUBLIC_* is inlined at BUILD time. Setting these in .env.local and
# restarting the server process does NOT turn the page on — the app must be rebuilt
# (`npm run build` / `bunx next build`) for a new value to reach the bundle.
#
# ⚠ These are gift destinations: money follows them and BTC is irreversible.
# Paste from the wallet that HOLDS the key, never from a doc or a chat log,
# and scan-check the rendered QR with the receiving wallet before announcing
# the page. A legacy 1…/3… BTC address is accepted on charset+length ONLY (no
# base58check verification — see lib/gift/btc-address.ts), so prefer bc1….
NEXT_PUBLIC_GIFT_XRD_ADDRESS=
NEXT_PUBLIC_GIFT_BTC_ADDRESS=
