# Supply-chain hardening: never run dependency lifecycle scripts.
# The root .npmrc doesn't reach the production host — the deploy syncs
# frontend/ alone and runs `bun install` there, so without this file a
# compromised transitive dep executes as the deploy user on a box that also
# runs other services. server/.npmrc exists for the same reason;
# frontend/ was the half of the 2026-07-17 security review's F16 left open.
#
# Verified: `bunx next build` succeeds with unrs-resolver's postinstall blocked
# (it is the only blocked script — see `bun pm untrusted`).
ignore-scripts=true
